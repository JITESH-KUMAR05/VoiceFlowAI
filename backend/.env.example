# Azure OpenAI — conversation and post-call analysis
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Murf AI — streamed text-to-speech
MURF_API_KEY=

# Twilio — outbound PSTN calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public base URL Twilio calls back to. Use an ngrok HTTPS URL in development;
# Twilio cannot reach localhost.
BASE_URL=http://localhost:8000

# Browser origins allowed to call this API, comma separated.
CORS_ORIGINS=http://localhost:8080

# Salesforce — SALESFORCE_DOMAIN is "login" for production, "test" for sandbox.
# Requires the custom Lead fields listed in the root README.
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_TOKEN=
SALESFORCE_DOMAIN=login

# SMTP for follow-up email. With Gmail this must be an App Password,
# not the account password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
