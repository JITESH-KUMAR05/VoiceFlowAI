# Azure OpenAI — conversation and post-call analysis.
# AZURE_OPENAI_DEPLOYMENT_NAME is the deployment's name in your Azure
# resource, not necessarily the underlying model's name. gpt-4.1 is the
# current recommendation here — tested head-to-head against gpt-4o and
# gpt-4o-mini on this project's actual prompts: matched or beat gpt-4o on
# both latency and reply quality, with no regressions. gpt-4o-mini was
# fastest in one run but skipped a step of the consultative-selling prompt
# in another (jumped straight to pitching instead of asking a clarifying
# question first) — a real risk for a persona built specifically around not
# rushing to the close, not just noise.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Murf AI — streamed text-to-speech
MURF_API_KEY=

# Twilio — outbound PSTN calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public base URL Twilio calls back to. Use an ngrok HTTPS URL in development;
# Twilio cannot reach localhost.
BASE_URL=http://localhost:8000

# Browser origins allowed to call this API, comma separated.
CORS_ORIGINS=http://localhost:8080

# Salesforce — requires the custom Lead fields listed in the root README
# (or run scripts/setup_salesforce_fields.py to create them). Two login
# modes; only one is used, whichever has its required values set:
#
# OAuth Client Credentials Flow (preferred — works on newer orgs):
#   From a Connected App / External Client App with "Enable Client
#   Credentials Flow" turned on and a "Run As" user set. SALESFORCE_DOMAIN
#   must be the org's actual My Domain here, NOT "login"/"test" — e.g. for
#   https://orgfarm-xxxx-dev-ed.develop.my.salesforce.com the domain is
#   orgfarm-xxxx-dev-ed.develop.my (everything before ".salesforce.com").
#   No username, password or token needed in this mode.
SALESFORCE_CONSUMER_KEY=
SALESFORCE_CONSUMER_SECRET=
SALESFORCE_DOMAIN=login

# Legacy SOAP username+password+token login (fallback — only used when
# CONSUMER_KEY/SECRET above are blank). Many newer orgs, trial "orgfarm"
# orgs especially, disable this by default and there is no admin toggle to
# turn it back on — if login fails with "SOAP API login() is disabled by
# default in this org", stop here and use OAuth above instead.
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_TOKEN=

# SMTP for follow-up email. With Gmail this must be an App Password,
# not the account password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
