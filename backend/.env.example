# Azure OpenAI — conversation and post-call analysis
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Murf AI — streamed text-to-speech
MURF_API_KEY=

# Twilio — outbound PSTN calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public base URL Twilio calls back to. Use an ngrok HTTPS URL in development;
# Twilio cannot reach localhost.
BASE_URL=http://localhost:8000

# Browser origins allowed to call this API, comma separated.
CORS_ORIGINS=http://localhost:8080

# Salesforce — SALESFORCE_DOMAIN is "login" for production, "test" for sandbox.
# Requires the custom Lead fields listed in the root README (or run
# scripts/setup_salesforce_fields.py to create them).
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_DOMAIN=login

# SALESFORCE_TOKEN: for orgs where SOAP API login is enabled. Newer orgs
# (trial "orgfarm" orgs especially) disable it by default — if login fails
# with "SOAP API login() is disabled by default in this org", leave TOKEN
# blank and set CONSUMER_KEY/CONSUMER_SECRET instead, from a Connected App /
# External Client App's OAuth settings. Only one of the two modes is used —
# whichever has both required values set.
SALESFORCE_TOKEN=
SALESFORCE_CONSUMER_KEY=
SALESFORCE_CONSUMER_SECRET=

# SMTP for follow-up email. With Gmail this must be an App Password,
# not the account password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
